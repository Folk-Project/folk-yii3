{
    "name": "folk/yii3",
    "description": "Yii 3 integration for Folk application server",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/Folk-Project/folk-yii3",
    "keywords": ["folk", "php", "yii", "yii3", "server"],
    "authors": [
        { "name": "Folk Contributors" }
    ],
    "require": {
        "php": ">=8.2",
        "folk/sdk": "^0.3.0",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-server-handler": "^1.0"
    },
    "suggest": {
        "yiisoft/log": "^2.0 — required for Yii3 logger context integration (request_id in app logs)",
        "monolog/monolog": "^3.0 — required for FolkRequestIdProcessor (request_id in app logs)"
    },
    "require-dev": {
        "yiisoft/di": "^1.0",
        "yiisoft/yii-http": "^1.0",
        "monolog/monolog": "^3.0",
        "nyholm/psr7": "^1.8",
        "dg/bypass-finals": "^1.8",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": { "Folk\\Yii3\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Folk\\Yii3\\Tests\\": "tests/" }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Folk-Project/folk-sdk"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": ["bin/folk-server"]
}
